# Apertium APy with /translateLLM, built from the apertium-apy submodule
# (our fork, branch giellatekno-main). Run from the umbrella repo root:
#
#   podman build -t apertium-apy-llm -f deploy/apy/Containerfile .
#
# The code is the submodule's working tree, so the image contains whatever is
# checked out there, uncommitted edits included. See deploy/README.md.

ARG DEBIAN_RELEASE=trixie

# ---------------------------------------------------------------- builder ---
FROM docker.io/library/debian:${DEBIAN_RELEASE}-slim AS builder

# nightly or release; must match the repo the VM's language pairs come from
ARG APERTIUM_CADENCE=nightly
ARG DEBIAN_RELEASE

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl make build-essential python3 python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY apertium-apy/ /src/

# Localised language names database. Built purely from the TSVs in the repo
# (scraped CLDR/SIL names), it does not depend on the installed pairs.
RUN make langNames.db

# Python deps, at the exact versions upstream's Pipfile.lock pins.
# fasttext is compiled here (needs g++/pybind11) and only the venv is copied on.
# fasttext 0.9.2 predates GCC 13+, which no longer pulls in <cstdint> implicitly.
RUN export CPPFLAGS='-include cstdint' && python3 -c 'import json; d = json.load(open("Pipfile.lock"))["default"]; print("\n".join(k + v["version"] for k, v in d.items()))' > /tmp/requirements.txt \
    && python3 -m venv /opt/apy/venv \
    && /opt/apy/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && /opt/apy/venv/bin/pip uninstall -y pybind11 setuptools \
    && sed -i 's/np\.array(probs, copy=False)/np.asarray(probs)/' /opt/apy/venv/lib/python3*/site-packages/fasttext/FastText.py \
    && grep -q 'np.asarray(probs)' /opt/apy/venv/lib/python3*/site-packages/fasttext/FastText.py
# ^ fasttext 0.9.2's predict() breaks on NumPy 2 (which upstream's lock pins);
#   this is the same one-line fix fastText itself made later.

# Only what is needed at runtime. RootHandler renders ../index.html relative
# to the package, so index.html sits next to apertium_apy/.
RUN mkdir -p /opt/apy/app \
    && cp -r apy.py apertium_apy index.html langNames.db lid.release.ftz COPYING llm.example.conf /opt/apy/app/ \
    && find /opt/apy -name __pycache__ -prune -exec rm -rf {} +

# Apertium apt repo for the runtime stage (which has no curl/TLS tooling)
RUN mkdir -p /out/etc/apt/trusted.gpg.d /out/etc/apt/preferences.d /out/etc/apt/sources.list.d \
    && curl -fsS https://apertium.projectjj.com/apt/apertium-packaging.public.gpg -o /out/etc/apt/trusted.gpg.d/apertium.gpg \
    && curl -fsS https://apertium.projectjj.com/apt/apertium.pref -o /out/etc/apt/preferences.d/apertium.pref \
    && echo "deb http://apertium.projectjj.com/apt/${APERTIUM_CADENCE} ${DEBIAN_RELEASE} main" > /out/etc/apt/sources.list.d/apertium.list

# ---------------------------------------------------------------- runtime ---
FROM docker.io/library/debian:${DEBIAN_RELEASE}-slim

COPY --from=builder /out/etc/apt/ /etc/apt/

# The tools that .mode files pipe text through. The language pairs are not in
# the image: start.sh fetches them from PAIRS_URL (on Cloudflare: from R2), or
# a host directory is mounted at /usr/share/apertium. Compiled pair data must
# match these tool versions; deploy/pairs/build.sh builds pairs inside this
# image, so rebuild the pairs archive after rebuilding the image.
# curl and zstd are for start.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 ca-certificates curl zstd \
        apertium lttoolbox cg3 hfst hfst-ospell \
        apertium-lex-tools apertium-separable apertium-recursive apertium-anaphora \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/apy /opt/apy
COPY deploy/apy/apy.conf /etc/apertium-apy/apy.conf
COPY deploy/apy/start.sh /opt/apy/start.sh

# start.sh unpacks the pairs into /usr/share/apertium as the apy user
RUN useradd --system --no-create-home --shell /usr/sbin/nologin apy \
    && chown apy:apy /usr/share/apertium /usr/share/apertium/modes
USER apy

ENV PATH=/opt/apy/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    LC_ALL=C.UTF-8

EXPOSE 2737

# start.sh (fetches the pairs, then runs APy with `-C <config>`) is the
# entrypoint; CMD is APy's other arguments, so `podman run IMAGE --help` or
# overriding the arguments works as expected. See start.sh for its env vars.
# --fasttext-model is here rather than in apy.conf because upstream's config
# parser crashes on options that default to None. The model ships with APy and
# knows sme, nob, nno and ~35 other languages.
ENTRYPOINT ["/opt/apy/start.sh"]
CMD ["--fasttext-model", "/opt/apy/app/lid.release.ftz", "/usr/share/apertium"]
