// Cloudflare Worker: serves the frontend (static assets), and runs APy in a
// container behind /apy/*. See deploy/README.md.
//
// This is the template for all instances: manage.py writes a copy per instance
// (.build/<instance>/wrangler.json) with the Worker name, R2 bucket and assets
// directory set, and deploys that. `wrangler types` reads this file directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apertium-template",  // manage.py: apertium-<instance>
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },

  // The apertium-html-tools build (manage.py: .build/<instance>/dist). Only
  // requests that don't match a file, and /apy/* and /admin/*, run the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/apy/*", "/admin/*"]
  },

  "containers": [
    {
      "class_name": "Apy",
      "scheduling_policy": "durable_object",
      "images": {
        // Built from the repo root, like `podman build -f deploy/apy/Containerfile .`
        "apy": { "dockerfile": "../apy/Containerfile", "build_context": "../.." }
      }
    }
  ],
  "exports": {
    "Apy": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [{ "name": "APY", "class_name": "Apy" }]
  },

  // Language pair archives, shared by all instances in an account:
  // pairs/<pair>/<version>.tar.zst, and pairs/<pair>/current naming the version
  // to use. Managed with `manage.py pairs`.
  "r2_buckets": [{ "binding": "PAIRS_BUCKET", "bucket_name": "apertium-pairs" }],

  "vars": {
    // The language pairs this instance serves, e.g. "sme-nob sme-smj"
    // (manage.py: from instances.toml)
    "PAIRS": "",
    // The LLM request APy makes (via llm.internal, see src/index.ts). The
    // deployment name picks the model: gpt-35-turbo runs gpt-4.1-mini, see
    // "LLM models" in deploy/README.md.
    "LLM_ENDPOINT": "https://gw-uit.intark.uh-it.no/azure-openai/openai/deployments/gpt-35-turbo/chat/completions?api-version=2024-02-01"
  },
  // Set on every deploy by manage.py, from secrets.<account>.env:
  //   APY_LLM_API_KEY  the gateway key; added by the Worker, never given to the container
  //   ADMIN_TOKEN      bearer token for POST /admin/restart
  "secrets": { "required": ["APY_LLM_API_KEY", "ADMIN_TOKEN"] }
}
